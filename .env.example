# ─────────────────────────────────────────────────────────────────────────────
# Variáveis de ambiente para produção com AWS RDS
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env com dados reais.
# ─────────────────────────────────────────────────────────────────────────────

# Endpoint do RDS (ex: database-1.xxxx.sa-east-1.rds.amazonaws.com)
RDSHOST=

# Porta do banco (padrão PostgreSQL: 5432)
DB_PORT=5432

# Nome do banco (padrão AWS em clusters novos: postgres)
DB_NAME=postgres

# Usuário do banco (deve ter a role rds_iam concedida: GRANT rds_iam TO postgres;)
DB_USERNAME=postgres

# Região AWS do RDS
AWS_REGION=sa-east-1

# Credenciais AWS para assinar o token IAM (SDK default credential chain).
# Em ECS/EC2/EKS, prefira uma IAM role anexada e DEIXE EM BRANCO.
# Preencha apenas para testes locais fora de um ambiente com role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Modo SSL da conexão JDBC
# 'require'  → obrigatório (padrão para RDS)
# 'disable'  → desligado  (apenas desenvolvimento local)
DB_SSL_MODE=require

# Tamanho do pool de conexões HikariCP
DB_POOL_MAX=10
DB_POOL_MIN=2

# Porta exposta da API no host (padrão: 8080)
API_PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Autenticação JWT
# ─────────────────────────────────────────────────────────────────────────────

# Segredo HMAC-SHA256 para assinar os tokens JWT (mínimo 32 bytes aleatórios).
# Gere com: openssl rand -base64 48
# Obrigatório em produção — NÃO existe fallback inseguro no perfil prod.
JWT_SECRET=

# Tempo de expiração do access token em milissegundos (padrão: 3600000 = 1h)
JWT_EXPIRATION_MS=3600000

